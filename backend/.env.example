# ============================================================
# Local Development Environment Variables
# ============================================================
# Copy to .env and adjust values as needed.
# The backend reads these via pydantic-settings (backend/app/core/config.py).
# ============================================================

ENVIRONMENT=development
LOG_LEVEL=INFO

# Azure AD — set these to your real values for Azure API calls,
# or leave blank to run in "mock" mode (health endpoints only).
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_IDS=

# Redis
REDIS_URL=redis://localhost:6379/0

# Database — PostgreSQL connection (async)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ops_portal
DB_ECHO=false

# SMTP (optional — notifications won't send without this)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_USE_TLS=true

# Key Vault (optional)
KEYVAULT_URL=

# CORS — allow local frontend
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:5174","http://localhost:5177"]

# Rate limiting
RATE_LIMIT_RPM=120

# Ollama / LLM (Leadership dashboard AI forecasts & advisor)
# Local Ollama default: http://localhost:11434
# ATT proxy example: https://customeraccountanalyser.test.att.com
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT_SECONDS=60
# Optional outbound auth for the LLM proxy (leave blank when not required)
OLLAMA_AUTH_HEADER_NAME=
OLLAMA_AUTH_HEADER_VALUE=
