# ============================================================
# Local Development Environment Variables
# ============================================================
# Copy to .env and adjust values as needed.
# The backend reads these via pydantic-settings (backend/app/core/config.py).
# ============================================================

ENVIRONMENT=development
LOG_LEVEL=INFO
# Local-only: set true to allow API calls without a Bearer token (never in production)
DEV_AUTH_BYPASS=false

# Azure AD — set these to your real values for Azure API calls,
# or leave blank to run in "mock" mode (health endpoints only).
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_IDS=

# Database — PostgreSQL connection (async)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ops_portal
DB_ECHO=false

# SMTP (optional — notifications won't send without this)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_USE_TLS=true

# Key Vault (optional)
KEYVAULT_URL=

# CORS — allow local frontend
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:5174","http://localhost:5177"]

# Rate limiting
RATE_LIMIT_RPM=120

# Leadership advisor LLM (Ollama-compatible proxy)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_AUTH_HEADER_NAME=
OLLAMA_AUTH_HEADER_VALUE=

# Agent assistant LLM (separate endpoint/model for future agentic layer)
AGENT_LLM_BASE_URL=http://localhost:11434
AGENT_LLM_MODEL=llama3.1
AGENT_LLM_TIMEOUT_SECONDS=120
AGENT_LLM_AUTH_HEADER_NAME=
AGENT_LLM_AUTH_HEADER_VALUE=

# ── Credential checks (Tools → Credential Check) ──────────────────────
# "Does this password / token still work?" for domain accounts, JFrog
# tokens and AAF accounts. Each check needs the WRITE role plus the
# credential_check capability, is rate limited per user, and is audited.
#
# A failed domain check counts as a failed sign-in against the AD lockout
# policy, so leave the LDAP URLs blank until the domain controllers and the
# portal's egress to them are agreed with the directory owners. Blank = the
# domain check reports itself unconfigured instead of attempting a bind.
CRED_CHECK_LDAP_ITSERVICES=
CRED_CHECK_LDAP_TESTITSERVICES=
CRED_CHECK_JFROG_URL=https://artifact.it.att.com
CRED_CHECK_AAF_URL_PROD=https://aaf-azure.it.att.com
CRED_CHECK_AAF_URL_NONPROD=https://aafist-azure.it.att.com
# Path that answers 200 for a valid basic-auth credential. Change it if your
# AAF instance exposes a different validation endpoint.
CRED_CHECK_AAF_PATH=/authn/basicAuth
CRED_CHECK_TIMEOUT_SECONDS=15
# PEM CA bundle for domain LDAPS and JFrog / AAF HTTPS. Include the approved
# issuing/root CA certificates, not just the server certificate.
# Single-quote Windows paths to preserve backslashes, e.g. 'C:\binary\ca-bundle.pem'.
CRED_CHECK_CA_BUNDLE=





