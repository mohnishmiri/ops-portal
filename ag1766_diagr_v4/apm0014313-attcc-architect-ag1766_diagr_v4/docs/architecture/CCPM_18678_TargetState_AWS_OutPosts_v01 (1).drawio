        <mxCell id="xFxmepdKVoL_snZISTia-0" parent="qcVyhp58iP8Gm4Rmxcgn-1" style="rounded=0;whiteSpace=wrap;html=1;align=left;" value="&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 22px;&quot;&gt;Notes&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;DB is Oracle EXACC - Kings Mountain, Alpharetta and St. Louis.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;No DR in On-Prem.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;CCPM has 3 environments Prod, Dev and Test&lt;/li&gt;&lt;li&gt;Datacenter:&amp;nbsp;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;&amp;nbsp;Alpharetta hosts Prod (8)&amp;nbsp; and Dev (1)&amp;nbsp;&lt;/li&gt;&lt;li&gt;St. Louis hosts Test(3)&lt;/li&gt;&lt;li&gt;Kings Moutain hosts Dev (2) and Test (2)&amp;nbsp;&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;NAS mounts are mounted on all app, web servers&lt;/li&gt;&lt;li&gt;Non-Prod and Prod both have load balancer.&lt;/li&gt;&lt;li&gt;In Scope VMs - 2 dev, 6 Test servers&lt;/li&gt;&lt;li&gt;Decomission servers - 1 dev, 2 test servers&amp;nbsp;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="271" width="496" x="-265.5" y="1252.91" as="geometry" />
        </mxCell>
